COMPOSE_PROJECT_NAME=azure-closed-ai-agent

# Traefik
ADMIN_HOST=admin.localhost
AGENT_HOST=agent.localhost
SKIP_BILLING=false

# Laravel / PostgreSQL
APP_URL=http://admin.localhost
DB_DATABASE=closed_agent
DB_USERNAME=laravel
DB_PASSWORD=secret
DB_PORT=5432

# 内部API（Laravel ↔ FastAPI）
INTERNAL_TOKEN=dev-internal-token-change-me
AGENT_URL=http://agent.localhost
CORS_ORIGINS=http://admin.localhost

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=localpassword
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

# Azure OpenAI（ローカルでは空のままでモック応答になる）
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# OpenRouter（手元の推論確認。キーは .env にだけ置く）
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Azurite（公式。compose 既定で Blob / Queue を踏む）
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;
AZURE_BLOB_CONTAINER=corpus
AZURE_INGEST_QUEUE=ingest

# Service Bus emulator（公式。SQL が要るので `make up-emulators`）
# ACCEPT_EULA=Y はエミュレータと SQL Server Linux の利用規約に同意したときだけ。
ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=ClosedAgent_Dev1!
AZURE_SERVICEBUS_CONNECTION_STRING=
AZURE_SERVICEBUS_QUEUE=ingest

# メール（手元は Mailpit。本番は Graph のメール通知）
MAILPIT_URL=http://127.0.0.1:8025
MAIL_FROM=agent@localhost
SMTP_HOST=
SMTP_PORT=1025

# Microsoft Graph（トークンが無いときは samples/office/microsoft の文書を入れる）
GRAPH_ACCESS_TOKEN=

# 身元（ローカルの Bearer。本番は Entra の oid を同じ Principal に載せる）
AUTH_MODE=local
AGENT_TOKENS=admin:local-admin,sales:local-sales,hr:local-hr,credit:local-credit,legal:local-legal
CHANNEL_WEBHOOK_SECRET=local-webhook
RATE_LIMIT_PER_MINUTE=60

# Entra（AUTH_MODE=entra のとき。未検証の JWT は受けない）
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
ENTRA_JWKS_URL=
ENTRA_ALLOW_UNKNOWN=false
ENTRA_ROLE_MAP=Admin:admin,Approver:approver,Auditor:auditor
ENTRA_GROUP_DEPARTMENTS=

# Azure AI Search（空なら手元の全文。本番は Private Endpoint の Search）
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=corpus
AZURE_SEARCH_API_VERSION=2024-07-01
